# ---- অবশ্যই বদলাতে হবে ----
GEMINI_API_KEY=এখানে_আপনার_Gemini_API_key
ADMIN_TOKEN=একটা_লম্বা_গোপন_পাসওয়ার্ড

# ---- সাইট ----
APP_NAME=LIVE CHAT
BLOG_URL=https://bdjobsinfo.com
# যে সাইটগুলো থেকে চ্যাট কল করা যাবে (কমা দিয়ে আলাদা)
ALLOWED_ORIGINS=https://bdjobsinfo.com,https://www.bdjobsinfo.com

# ---- মডেল (দরকার হলে বদলান; নাম Google AI Studio-তে মিলিয়ে নিন) ----
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001

# ---- ফ্রি টিয়ার রক্ষা ----
RATE_LIMIT_PER_HOUR=20
DAILY_CHAT_CAP=800
SYNC_INTERVAL_MIN=60

# ---- ফাইল/ছবি/লিংক ----
OCR_IMAGES=true
# auto = লেখা না পেলে OCR, always = সবসময় OCR (পুরনো ফন্টের বাংলা PDF-এ ভালো), never = বন্ধ
PDF_OCR=auto
MAX_FILES_PER_POST=5
MAX_IMAGES_PER_POST=5
